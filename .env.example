# Model key for the llm worker. Not needed with `fixagent worker llm --demo`.
ANTHROPIC_API_KEY=

# Optional: send redacted decision receipts to Tenuo Cloud. Leave empty for local enforcement only.
TENUO_CONNECT_TOKEN=
TENUO_API_KEY=
TENUO_AUTHORIZER_NAME=
TENUO_CONTROL_PLANE_URL=https://api.tenuo.ai

# Temporal frontend address. Defaults to localhost:7233 (the `fixagent temporal` dev server).
TEMPORAL_ADDRESS=localhost:7233
